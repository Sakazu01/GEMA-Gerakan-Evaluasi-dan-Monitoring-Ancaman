# Server secrets only; never expose the secret/service-role key to the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MODEL_API_KEY=
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000
COMMUNITY_ENABLED=true
RATE_LIMIT_SALT=
MODEL_DAILY_BUDGET=200
MAX_PHOTO_BYTES=10485760
REPORT_ACTIVE_TTL_HOURS=12
OBSERVATION_FRESHNESS_MIN=30
DEVICE_LOCATION_MAX_AGE_MIN=5
CONFIRMATION_RADIUS_M=500
IMAGE_SIMILARITY_HAMMING_MAX=5
PROVENANCE_RESULT_LIMIT=3
PUBLIC_APP_URL=

# Optional reverse-image evidence. Reports still continue when disabled/unavailable.
WEB_IMAGE_PROVIDER=none
GOOGLE_VISION_API_KEY=
WEB_IMAGE_TIMEOUT_SECONDS=8

# Enable after migrations and local/staging verification. Runs cleanup + persistent outbox.
WORKER_ENABLED=false
WORKER_INTERVAL_SECONDS=15

# Optional private responder group; IDs must also be mapped in telegram_responders + user_roles.
TELE_API=
TELE_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RESPONDER_IDS=

# Optional Web Push; VAPID_PRIVATE_KEY belongs only on this server.
PUSH_ENABLED=false
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
