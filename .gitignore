# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- frontend (Next.js) ---
frontend/node_modules
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage
frontend/.next/
frontend/out/
frontend/build
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel

# --- backend (FastAPI/Python) ---
backend/.venv
backend/venv
backend/__pycache__/
**/__pycache__/
backend/*.egg-info
backend/.pytest_cache
backend/.mypy_cache

# --- lokal per-mesin (jangan dishare ke tim) ---
.claude/

# --- misc ---
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# foto uji tidak ikut repo (hak cipta pemilik foto); kunci jawaban dan hasil evaluasi tetap ikut
backend/tests/fixtures/foto/*
!backend/tests/fixtures/foto/README.md
# catatan keluaran model versi lama (sekali pakai)
backend/tests/output/test*.txt

# env files (each project loads its own; never commit real values)
.env
.env.local
*.env
!*.env.example

# Local test databases and screenshots; never application data.
/tmp/
/frontend/test-results/
/frontend/playwright-report/
